# btc-smc-bot environment variables
# Copy to .env and fill in real values

# ── Binance Futures ───────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_futures_api_key
BINANCE_API_SECRET=your_binance_futures_api_secret
BINANCE_TESTNET=1   # Set to 0 for live trading

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_numeric_id

# ── News API ──────────────────────────────────────────────────────────────────
FCS_API_KEY=your_fcs_api_key

# ── Strategy parameters (overrides code defaults) ────────────────────────────
CONFLUENCE_THRESHOLD=65     # Min score to generate signal (default 65)
MAX_RISK_PCT=0.01           # 1% per trade (do NOT increase for futures)
MAX_LEVERAGE=3              # Max leverage for BTC futures (default 3x)
SCAN_INTERVAL_MINUTES=15    # How often to scan (default 15 min)

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=btc_smc.db
